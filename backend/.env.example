# Real API Configuration for Provenance Platform
# Copy this file to .env and add your actual API keys

# Google Fact Check Tools API
# Get from: https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# News API for authentic media samples
# Get from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# OpenAI API for advanced AI detection (optional)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face API for AI models (optional)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# TinEye API for reverse image search (optional)
# Get from: https://tineye.com/business/developer
TINEYE_API_KEY=your_tineye_api_key_here
TINEYE_PRIVATE_KEY=your_tineye_private_key_here

# Database Configuration
DATABASE_URL=sqlite:///database/playground.db

# Application Settings
MAX_FILE_SIZE=10485760
CORS_ORIGINS=http://localhost:3000
API_TITLE=Provenance API
DEBUG_MODE=true

# Content Credentials (C2PA) - when available
# C2PA_ENABLED=false
# C2PA_PRIVATE_KEY_PATH=path/to/private/key.pem
# C2PA_CERTIFICATE_PATH=path/to/certificate.pem

# AI Detection Settings
AI_DETECTION_ENABLED=true
AI_DETECTION_CONFIDENCE_THRESHOLD=0.7
TECHNICAL_ANALYSIS_ENABLED=true

# Fact Checking Settings
FACT_CHECK_ENABLED=true
FACT_CHECK_CACHE_DURATION_HOURS=24

# Media Dataset Settings
VERIFIED_MEDIA_PATH=../verified-media
DOWNLOAD_REAL_SAMPLES=false